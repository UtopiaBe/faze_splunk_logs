# FAZE Security API Configuration
# Copy this file to .env and fill in your actual values

# FAZE API Key (Required)
# Get this from your FAZE Security dashboard: https://app.faze.security/settings/api-keys
FAZE_API_KEY=vJySWYkE-6WQ3-V3AL-I2vbh2pM
# FAZE API URL (Optional, defaults to production)
FAZE_API_URL=https://api.faze.security
# FAZE Disable SSL (Optional, defaults to false)
FAZE_DISABLE_SSL="true"
# FAZE Art ID (Optional, defaults to 1000)
FAZE_ART_ID=1000