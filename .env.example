# FAZE Security API Configuration
# Copy this file to .env and fill in your actual values

# FAZE API Key (Required)
# Get this from your FAZE Security dashboard: https://app.faze.security/settings/api-keys
FAZE_API_KEY=your_faze_api_key_here

# FAZE API URL (Optional, defaults to production)
FAZE_API_URL=https://api.faze.security

# Splunk HEC Configuration (Optional, for direct HEC indexing)
SPLUNK_HEC_TOKEN=your_hec_token_here
SPLUNK_HEC_URL=https://your-splunk-instance:8088
SPLUNK_INDEX=security

# Splunk Authentication (if using direct connection)
SPLUNK_HOST=localhost
SPLUNK_PORT=8089
SPLUNK_USERNAME=admin
SPLUNK_PASSWORD=your_splunk_password

# Scan Configuration
SCAN_INTERVAL=3600
INCLUDE_ASSETS_FILTER=
EXCLUDE_ASSETS_FILTER=

# Logging
LOG_LEVEL=INFO
DEBUG_MODE=false

# Proxy Configuration (if needed)
HTTPS_PROXY=
HTTP_PROXY=
PROXY_USERNAME=
PROXY_PASSWORD=
